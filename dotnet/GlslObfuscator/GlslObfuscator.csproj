    <RootNamespace>Niwer.GlslObfuscator</RootNamespace>
    <AssemblyName>Niwer.GlslObfuscator</AssemblyName>
    <PackageId>Niwer.GlslObfuscator</PackageId>
    <Description>GLSL shader minifier and obfuscator.</Description>
    <PackageReadmeFile>README.MD</PackageReadmeFile>
