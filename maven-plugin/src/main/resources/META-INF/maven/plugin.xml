<plugin>
    <name>GLSL Obfuscator Maven Plugin</name>
    <description>Obfuscates GLSL shader files during the Maven resource-processing phase.</description>
    <groupId>com.github.Niwer1525.glsl_obfuscator</groupId>
    <!-- <groupId>com.niwer</groupId> --> <!-- For development purposes only -->
    <artifactId>glsl-obfuscator-maven-plugin</artifactId>
    <version>${projectVersion}</version>
    <goalPrefix>glsl</goalPrefix>
    <isolatedRealm>false</isolatedRealm>
    <inheritedByDefault>true</inheritedByDefault>
    <requiredJavaVersion>21</requiredJavaVersion>
    <mojos>
        <mojo>
            <goal>obfuscate</goal>
            <description>Obfuscates GLSL shader files.</description>
            <requiresDependencyResolution>runtime</requiresDependencyResolution>
            <requiresProject>true</requiresProject>
            <requiresReports>false</requiresReports>
            <aggregator>false</aggregator>
            <requiresDirectInvocation>false</requiresDirectInvocation>
            <phase>process-resources</phase>
            <implementation>com.niwer.glsl_obfuscator.maven.MavenGlslMojo</implementation>
            <language>java</language>
            <instantiationStrategy>per-lookup</instantiationStrategy>
            <executionStrategy>once-per-session</executionStrategy>
            <threadSafe>false</threadSafe>
            <parameters>
                <parameter>
                    <name>sourceDir</name>
                    <type>java.io.File</type>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Source directory containing GLSL files.</description>
                </parameter>
                <parameter>
                    <name>linked</name>
                    <type>boolean</type>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Whether to link symbols across shader files (#import or #include).</description>
                </parameter>
                <parameter>
                    <name>minify</name>
                    <type>boolean</type>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Whether to minify the output code.</description>
                </parameter>
                <parameter>
                    <name>seed</name>
                    <type>java.lang.Long</type>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Seed value to ensure reproducible symbol generation across builds.</description>
                </parameter>
                <parameter>
                    <name>separateFuncsAndVars</name>
                    <type>boolean</type>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Whether to obfuscate function and variable names separately.</description>
                </parameter>
                <parameter>
                    <name>excludedSymbols</name>
                    <type>java.util.List</type>
                    <required>false</required>
                    <editable>true</editable>
                    <description>List of variable or function identifiers to preserve.</description>
                </parameter>
                <parameter>
                    <name>excludedFiles</name>
                    <type>java.util.List</type>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Ant-style patterns of files to ignore completely.</description>
                </parameter>
            </parameters>
        </mojo>
    </mojos>
</plugin>